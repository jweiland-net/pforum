{
	"name": "jweiland/pforum",
	"description": "Lightweight forum extension for TYPO3",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"TYPO3 CMS",
		"forum",
		"pforum",
		"lightweight"
	],
	"authors": [
		{
			"name": "Stefan Froemken",
			"email": "projects@jweiland.net",
			"role": "Developer"
		},
		{
			"name": "Hoja Mustaffa Abdul Latheef",
			"email": "projects@jweiland.net",
			"role": "Developer"
		}
	],
	"homepage": "https://jweiland.net",
	"support": {
		"email": "support@jweiland.net",
		"issues": "https://github.com/jweiland-net/pforum/issues",
		"source": "https://github.com/jweiland-net/pforum"
	},
	"require": {
		"typo3/cms-core": "^13.4"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.44",
		"phpstan/phpdoc-parser": "^1.33",
		"ssch/typo3-rector": "^3.6",
		"typo3/cms-install": "^13.4",
		"typo3/coding-standards": "^0.8",
		"typo3/testing-framework": "^9.0.1"
	},
	"replace": {
		"typo3-ter/pforum": "self.version"
	},
	"autoload": {
		"psr-4": {
			"JWeiland\\Pforum\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"JWeiland\\Pforum\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"app-dir": ".Build",
			"extension-key": "pforum",
			"web-dir": ".Build/public"
		}
	}
}
