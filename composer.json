{
	"name": "jweiland/pforum",
	"description": "Lightweight forum extension for TYPO3",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"TYPO3 CMS",
		"forum",
		"pforum",
		"lightweight"
	],
	"authors": [
		{
			"name": "Stefan Froemken",
			"email": "projects@jweiland.net",
			"role": "Developer"
		},
		{
			"name": "Hoja Mustaffa Abdul Latheef",
			"email": "projects@jweiland.net",
			"role": "Developer"
		}
	],
	"homepage": "https://jweiland.net",
	"support": {
		"email": "support@jweiland.net",
		"issues": "https://github.com/jweiland-net/pforum/issues",
		"source": "https://github.com/jweiland-net/pforum"
	},
	"require": {
		"php": "^8.2",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-core": "^14.3",
		"typo3/cms-extbase": "^14.3",
		"typo3/cms-fluid": "^14.3",
		"typo3/cms-frontend": "^14.3"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.44",
		"phpstan/phpstan": "^2.1",
		"saschaegerer/phpstan-typo3": "^3.0",
		"ssch/typo3-rector": "^3.17",
		"typo3/cms-install": "^14.3",
		"typo3/cms-rte-ckeditor": "^14.3",
		"typo3/coding-standards": "^0.8",
		"typo3/testing-framework": "^9.7",
		"rector/rector": "~2.8.3"
	},
	"replace": {
		"typo3-ter/pforum": "self.version"
	},
	"suggest": {
		"jweiland/checkfaluploads": "Adds a mandatory rights checkbox to file uploads in pforum's forms. Requires a release of EXT:checkfaluploads, which supports TYPO3 14.",
		"typo3/cms-rte-ckeditor": "Needed for the optional rich text editor (CKEditor 5) of the description of topics and posts (site setting pforum.form.richText.enable)."
	},
	"autoload": {
		"psr-4": {
			"JWeiland\\Pforum\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"JWeiland\\Pforum\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true,
			"phpstan/extension-installer": true
		},
		"bin-dir": ".Build/bin",
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"extension-key": "pforum",
			"version": "9.0.0",
			"web-dir": ".Build/public"
		}
	}
}
