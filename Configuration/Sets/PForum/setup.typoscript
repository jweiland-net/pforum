plugin.tx_pforum {
  view {
    templateRootPaths.100 = {$pforum.templateRootPath}
    partialRootPaths.100 = {$pforum.partialRootPath}
    layoutRootPaths.100 = {$pforum.layoutRootPath}
  }

  persistence {
    storagePid = {$pforum.storagePid}
  }

  settings {
    auth = {$pforum.auth}
    emailIsMandatory = {$pforum.emailIsMandatory}
    usernameIsMandatory = {$pforum.usernameIsMandatory}
    useImages = {$pforum.useImages}
    uidOfAdminGroup = {$pforum.uidOfAdminGroup}
    uidOfUserGroup = {$pforum.uidOfUserGroup}
    pidOfDetailPage = {$pforum.pidOfDetailPage}
    topic {
      hideAtCreation = {$pforum.topic.hideAtCreation}
      activateByAdmin = {$pforum.topic.activateByAdmin}
    }

    post {
      hideAtCreation = {$pforum.post.hideAtCreation}
      activateByAdmin = {$pforum.post.activateByAdmin}
    }

    new {
      # Folder of the images of topics and posts uploaded in frontend
      uploadFolder = {$pforum.new.uploadFolder}
      # CKEditor 5 of EXT:rte_ckeditor for the description of topics and posts
      richText {
        enable = {$pforum.form.richText.enable}
        # Comma separated names of fields
        elements = {$pforum.form.richText.elements}
        # Folder with the translations of CKEditor
        translationsPath = {$pforum.form.richText.translationsPath}
      }
    }

    email {
      # Template root paths of the mails of pforum. Used for these mails only.
      templateRootPaths {
        0 = EXT:pforum/Resources/Private/Templates/Email/
      }
    }

    image {
      width = {$pforum.image.width}
      height = {$pforum.image.height}
      minWidth = {$pforum.image.minWidth}
      maxWidth = {$pforum.image.maxWidth}
      minHeight = {$pforum.image.minHeight}
      maxHeight = {$pforum.image.maxHeight}
    }

    pageBrowser {
      itemsPerPage = {$pforum.pageBrowser.itemsPerPage}
    }
  }
}

plugin.tx_pforum._CSS_DEFAULT_STYLE (
	textarea.f3-form-error {
		background-color:#FF9F9F;
		border: 1px #FF0000 solid;
	}

	input.f3-form-error {
		background-color:#FF9F9F;
		border: 1px #FF0000 solid;
	}
)
